#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

REPO_DIR="${CATALOG_REPO_DIR:-/opt/subscription-source-catalog}"
LOCK_FILE="${CATALOG_LOCK_FILE:-/run/lock/subscription-source-catalog.lock}"
EXPECTED_BRANCH="${CATALOG_BRANCH:-main}"\nEXPECTED_SHA="${CATALOG_EXPECTED_SHA:-}"
SHARDS="${CATALOG_SHARDS:-20}"
MAX_SOURCES="${CATALOG_MAX_SOURCES:-80}"
WORKERS="${CATALOG_WORKERS:-2}"
GEO_MAX_NEW="${CATALOG_GEO_MAX_NEW:-25}"
TOP_PER_COUNTRY="${CATALOG_TOP_PER_COUNTRY:-30}"
COUNTRY_EXPORT_LIMIT="${CATALOG_COUNTRY_EXPORT_LIMIT:-500}"
MAX_PER_SOURCE="${CATALOG_MAX_PER_SOURCE:-5}"
PUBLISH="${CATALOG_PUBLISH:-1}"
SSH_PORT="${CATALOG_SSH_PORT:-22022}"

log() { printf '%s %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

for cmd in git python3 curl gzip sha256sum stat flock find sort xargs ip pgrep ss awk wc date; do need "$cmd"; done
[[ -d "$REPO_DIR/.git" ]] || die "repository not found: $REPO_DIR"
mkdir -p "$(dirname "$LOCK_FILE")"
exec 9>"$LOCK_FILE"
flock -n 9 || die "another catalog pipeline is already running"

cd "$REPO_DIR"
branch="$(git symbolic-ref --quiet --short HEAD || true)"
[[ "$branch" == "$EXPECTED_BRANCH" ]] || die "expected branch $EXPECTED_BRANCH, got ${branch:-detached}"
[[ -z "$(git status --porcelain --untracked-files=all)" ]] || die "working tree is not clean"

ssh_listener_state() {
  ss -ltnH | awk -v p=":$SSH_PORT" '$4 ~ p"$" {print $1 "|" $4}' | sort
}

BEFORE_ROUTE="$(ip route show default 2>/dev/null || true)"
BEFORE_XUI_PID="$(pgrep -xo x-ui 2>/dev/null || true)"
BEFORE_SSH_LISTEN="$(ssh_listener_state)"
[[ -n "$BEFORE_SSH_LISTEN" ]] || die "SSH listener not found on port $SSH_PORT"

cleanup() {
  rc=$?

  after_route="$(ip route show default 2>/dev/null || true)"
  after_xui_pid="$(pgrep -xo x-ui 2>/dev/null || true)"
  after_ssh_listen="$(ssh_listener_state)"

  if [[ "$after_route" != "$BEFORE_ROUTE" ]]; then
    log "CRITICAL: host default route changed during catalog pipeline"
    rc=90
  fi

  if [[ -n "$BEFORE_XUI_PID" && "$after_xui_pid" != "$BEFORE_XUI_PID" ]]; then
    log "CRITICAL: x-ui PID changed during catalog pipeline"
    rc=91
  fi

  if [[ "$after_ssh_listen" != "$BEFORE_SSH_LISTEN" ]]; then
    log "CRITICAL: SSH listener state changed on port $SSH_PORT"
    rc=92
  fi

  if (( rc == 0 )); then
    rm -rf .catalog-runtime
  else
    log "pipeline failed; preserving .catalog-runtime for recovery evidence"
  fi

  exit "$rc"
}
trap cleanup EXIT

log "preflight: fetch and fast-forward"
git fetch --prune origin "$EXPECTED_BRANCH"
remote_sha="$(git rev-parse "origin/$EXPECTED_BRANCH")"
if [[ -n "$EXPECTED_SHA" && "$remote_sha" != "$EXPECTED_SHA" ]]; then
  die "remote candidate SHA mismatch: expected $EXPECTED_SHA, got $remote_sha"
fi
git merge-base --is-ancestor HEAD "$remote_sha" || die "local HEAD diverged from origin/$EXPECTED_BRANCH"
git merge --ff-only "$remote_sha"
[[ "$(git rev-parse HEAD)" == "$remote_sha" ]] || die "post-fast-forward HEAD mismatch"

mkdir -p .catalog-runtime/geoip .catalog-runtime/compute .catalog-runtime/pycache
export PYTHONPYCACHEPREFIX="$REPO_DIR/.catalog-runtime/pycache"

VENV="$REPO_DIR/.venv"
[[ -x "$VENV/bin/python" ]] || die "virtualenv missing: $VENV"
PY="$VENV/bin/python"

log "preflight: unit tests"
"$PY" -m unittest discover -s tests -v
"$PY" -m compileall -q src run.py compute.py streaming_merge.py coverage_stream_cli.py coverage_shadow_consensus.py state_store.py validate_staged_publication.py


prepare_geoip() {
  local dir=.catalog-runtime/geoip
  local data_url='https://github.com/sapics/ip-location-db/releases/download/latest/server-country.mmdb'
  local sum_url='https://github.com/sapics/ip-location-db/releases/download/checksum/server-country.mmdb.sha256'
  if curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 15 --max-time 90 --max-filesize 20000000 --proto '=https' --tlsv1.2 "$data_url" -o "$dir/server-country.mmdb" \
    && curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 15 --max-time 30 --max-filesize 4096 --proto '=https' --tlsv1.2 "$sum_url" -o "$dir/server-country.mmdb.sha256"; then
    expected="$(awk 'NF {print tolower($1); exit}' "$dir/server-country.mmdb.sha256")"
    actual="$(sha256sum "$dir/server-country.mmdb" | awk '{print tolower($1)}')"
    bytes="$(stat -c '%s' "$dir/server-country.mmdb")"
    if [[ "$expected" =~ ^[0-9a-f]{64}$ && "$actual" == "$expected" ]] && (( bytes >= 1000000 && bytes <= 20000000 )); then
      printf 'sha256:%s\n' "$actual" > "$dir/release.txt"
    else
      rm -f "$dir/server-country.mmdb" "$dir/release.txt"
    fi
  fi
  for ym in "$(date -u +%Y-%m)" "$(date -u -d '1 month ago' +%Y-%m)"; do
    url="https://download.db-ip.com/free/dbip-country-lite-${ym}.mmdb.gz"
    rm -f "$dir/dbip-country-lite.mmdb.gz" "$dir/dbip-country-lite.mmdb"
    if curl --fail --location --silent --show-error --retry 3 --retry-all-errors --connect-timeout 15 --max-time 90 --max-filesize 20000000 --proto '=https' --tlsv1.2 "$url" -o "$dir/dbip-country-lite.mmdb.gz" \
      && gzip -t "$dir/dbip-country-lite.mmdb.gz" \
      && gzip -dc "$dir/dbip-country-lite.mmdb.gz" > "$dir/dbip-country-lite.mmdb"; then
      bytes="$(stat -c '%s' "$dir/dbip-country-lite.mmdb")"
      if (( bytes >= 1000000 && bytes <= 20000000 )); then
        actual="$(sha256sum "$dir/dbip-country-lite.mmdb" | awk '{print tolower($1)}')"
        printf 'dbip-country-lite-%s sha256:%s\n' "$ym" "$actual" > "$dir/dbip-release.txt"
        break
      fi
    fi
  done
  rm -f "$dir/dbip-country-lite.mmdb.gz"
}

log "discovery: Git transport backend"
"$PY" run.py --backend git

log "prepare passive GeoIP shadow datasets"
prepare_geoip

shadow_args=()
secondary_shadow_args=()
if [[ -s .catalog-runtime/geoip/server-country.mmdb && -s .catalog-runtime/geoip/release.txt ]]; then
  shadow_args=(--geo-shadow-mmdb .catalog-runtime/geoip/server-country.mmdb --geo-shadow-provider sapics-server-country --geo-shadow-release "$(cat .catalog-runtime/geoip/release.txt)")
fi
if [[ -s .catalog-runtime/geoip/dbip-country-lite.mmdb && -s .catalog-runtime/geoip/dbip-release.txt ]]; then
  secondary_shadow_args=(--geo-shadow-secondary-mmdb .catalog-runtime/geoip/dbip-country-lite.mmdb --geo-shadow-secondary-provider dbip-country-lite --geo-shadow-secondary-release "$(cat .catalog-runtime/geoip/dbip-release.txt)")
fi

log "compute: $SHARDS logical shards"
for (( shard=0; shard<SHARDS; shard++ )); do
  log "compute shard $shard/$((SHARDS-1))"
  "$PY" compute.py --shard "$shard" --shards "$SHARDS" --max-sources "$MAX_SOURCES" --workers "$WORKERS" --geo-max-new "$GEO_MAX_NEW" \
    "${shadow_args[@]}" "${secondary_shadow_args[@]}" --output ".catalog-runtime/compute/shard-${shard}.json"
done

count="$(find .catalog-runtime/compute -maxdepth 1 -type f -name 'shard-*.json' | wc -l)"
[[ "$count" -eq "$SHARDS" ]] || die "expected $SHARDS shard artifacts, found $count"

log "streaming merge and rank"
"$PY" streaming_merge.py \
  --artifacts .catalog-runtime/compute \
  --expected-shards "$SHARDS" \
  --top-per-country "$TOP_PER_COUNTRY" \
  --country-export-limit "$COUNTRY_EXPORT_LIMIT" \
  --max-per-source "$MAX_PER_SOURCE"

log "shadow consensus coverage"
"$PY" coverage_shadow_consensus.py \
  --artifacts .catalog-runtime/compute \
  --expected-shards "$SHARDS"

log "verify bounded generated state"
while IFS= read -r -d '' file; do
  bytes="$(stat -c '%s' "$file")"
  (( bytes <= 50000000 )) || die "generated state shard exceeds 50 MB: $file ($bytes)"
done < <(find data/node_index exports/nodes_deduplicated -type f -name '*.json' -print0)

log "post-compute regression tests"
"$PY" -m unittest discover -s tests -v

log "stage publication allowlist"
git add data/sources.json data/geo_cache.json SOURCES.md exports/subscription_urls.txt exports/prechecked_sources.json exports/country_handoff.json exports/country_handoff_v4.json exports/coverage_metrics.json
git add -A -- data/node_index exports/nodes_deduplicated exports/countries
for legacy in data/node_index.json exports/nodes_deduplicated.json; do
  if git ls-files --error-unmatch "$legacy" >/dev/null 2>&1; then git add -u -- "$legacy"; fi
done

# Fail closed if anything outside the publication allowlist changed.
unstaged="$(git status --porcelain | awk '$1 !~ /^\?\?/ {print substr($0,4)}' | grep -vE '^(data/sources\.json|data/geo_cache\.json|SOURCES\.md|exports/subscription_urls\.txt|exports/prechecked_sources\.json|exports/country_handoff\.json|exports/country_handoff_v4\.json|exports/coverage_metrics\.json|data/node_index/|exports/nodes_deduplicated/|exports/countries/)' || true)"
[[ -z "$unstaged" ]] || die "unexpected modified paths: $unstaged"

if git diff --cached --quiet; then
  log "no catalog changes"
  exit 0
fi

log "scan staged publication for sensitive content"
"$PY" validate_staged_publication.py

if [[ "$PUBLISH" != 1 ]]; then
  log "publication disabled; leaving validated changes staged"
  exit 0
fi

log "publish sanitized generated state"
git config user.name "catalog-pipeline"
git config user.email "catalog-pipeline@localhost"
git commit -m "chore(catalog): owner-operated pipeline update [skip ci]"
git fetch origin "$EXPECTED_BRANCH"
post_remote_sha="$(git rev-parse "origin/$EXPECTED_BRANCH")"
[[ "$post_remote_sha" == "$remote_sha" ]] || die "remote branch advanced during pipeline"
[[ "$(git rev-parse HEAD)" == "$remote_sha" ]] || die "pipeline code HEAD changed during transaction"
git push origin "HEAD:$EXPECTED_BRANCH"
log "pipeline complete"
